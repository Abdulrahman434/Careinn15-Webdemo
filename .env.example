# CMS configuration (optional - if omitted, the app uses hardcoded fallback content)
VITE_STRAPI_URL=https://YOUR-PROJECT.strapiapp.com
VITE_HOSPITAL_SLUG=dallah-hospital

# DEMO / TEST deployments ONLY — never set this for a hospital build.
# Lets "Forgot PIN" accept the built-in demo patient's MRN while no real patient
# is admitted on the screen. Off when unset. Not needed for `npm run dev`
# (always on there); add it to .env.local only to try a production build locally.
# VITE_ENABLE_DEMO_PATIENT=true
