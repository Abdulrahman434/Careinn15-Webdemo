# Serving the kiosk build from Apache (Plesk, or Apache on Lightsail).
#
# Vite builds with base "./", so this works whether the site is a vhost root
# or a subfolder. There is no client-side router — the app is one page — so
# the only rewrite here is a safety net for stray URLs.
#
# Copied into dist/ by every build, because it lives in public/.

# ── Cache ────────────────────────────────────────────────────────────────
# Asset filenames carry a content hash, so they can be cached forever. The
# entry point and the service worker must never be, or a kiosk keeps running
# last month's build after a deploy — which is exactly how a stale screen
# survives a release.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html|sw\.js|workbox-[^/]+\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hospital PDFs and guides change between admissions; a day is plenty.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ── Types Apache does not always know ────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType video/mp4                 .mp4
  AddType font/woff2                .woff2
  AddType image/svg+xml             .svg
  # Apache sends WebP with no Content-Type at all. Browsers sniff the magic
  # bytes and render it anyway; proxies, CDN edges and anything loading it
  # through fetch() go by the header.
  AddType image/webp                .webp
  AddType text/javascript           .mjs
</IfModule>

# ── Compression ──────────────────────────────────────────────────────────
# Text only. Compressing the video and the PDFs again costs CPU and saves
# nothing — they are already compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json \
    image/svg+xml
</IfModule>

# ── Fallback ─────────────────────────────────────────────────────────────
# Everything that is not a real file goes to the app. Real files — the PDFs,
# the guides, the NFC login page, the slideshow — are served as themselves.
#
# Except under /assets/, where a file that is not there is missing rather than
# mistyped: those names are emitted by the build and nobody types one. Handing
# back index.html there answers a request for a photograph with 200 and a web
# page, and a 200 is a success — the service worker stores that HTML under the
# image's own URL, and a CDN edge would serve it to every patient at once. It
# is how a renamed asset takes the images down and keeps them down, which has
# happened to this app twice. A 404 is cached by nobody and recovers on the
# next load.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} ^/assets/
  RewriteRule ^ - [L,R=404]
  RewriteRule ^ index.html [L]
</IfModule>
